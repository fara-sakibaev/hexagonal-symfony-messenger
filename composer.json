{
    "name": "fara-sakibaev/hexagonal-symfony-messenger",
    "description": "Symfony Messenger adapter for Hexagonal core contracts",
    "type": "library",

    "repositories": [
        {
            "type": "path",
            "url": "../hexagonal-core",
            "options": {
                "symlink": true
            }
        }
    ],

    "autoload": {
        "psr-4": {
            "Hexagonal\\SymfonyMessenger\\": "src/"
        }
    },

    "require": {
        "php": "^8.4",
        "fara-sakibaev/hexagonal-core": "@dev",
        "symfony/messenger": "^7.3 || ^8.0",
        "symfony/http-kernel": "^7.3 || ^8.0",
        "symfony/dependency-injection": "^7.3 || ^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0",
        "symfony/framework-bundle": "^7.3 || ^8.0"
    }
}
